datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS DE ACESSO & SUPORTE
// ----------------------------------------------------
enum UserRole {
  ADMIN
  CLIENT
}

enum TicketCategory {
  BASIC        // Troca de texto, imagem, criação de e-mail corporativo (SLA: 24h)
  INTERMEDIATE // Ajustes de layout, cores, ordem de seções, carrossel (SLA: 72h)
  ADVANCED     // Novas rotas, refatoração de blocos, integrações (SLA: 168h / 7 dias)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CANCELLED
}

// ----------------------------------------------------
// ENUMS FINANCEIROS & CONTRATOS
// ----------------------------------------------------
enum ContractType {
  SUSTAINABILITY // Planos Mensais: Essential (100), Development (300), Advanced (700)
  PROJECT_DEV    // Setup / Implantação (Templates, Personalizado, SaaS)
  HYBRID         // Contrato consolidado (Setup + Sustentação)
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum InstallmentStatus {
  SCHEDULED // Parcela futura acordada (ex: milestone 30, 60, 90, 120 dias)
  BILLED    // Parcela faturada dentro de uma fatura mensal
  PAID      // Paga
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING   // Fatura emitida aguardando liquidação
  PAID      // Baixa confirmada
  OVERDUE   // Em atraso
  CANCELLED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
  MANUAL_TRANSFER
}

// ----------------------------------------------------
// ENUMS DO FLUXO DE CAIXA DA MINDSITE (PAINEL DO DONO)
// ----------------------------------------------------
enum ExpenseCategory {
  INFRASTRUCTURE // Vercel Pro, Supabase Pro, Domínios Registro.br, HostGator
  SAAS_TOOLS     // Resend, Autentique, GitHub, Figma, Adobe
  MARKETING_ADS  // Meta Ads, Google Ads
  LEGAL_TAXES    // Simples Nacional / DAS, Contador, Alvará
  OPERATIONAL    // Equipamentos, Escritório
  OTHER
}

enum ExpenseFrequency {
  RECURRENT_MONTHLY
  RECURRENT_ANNUAL
  SPORADIC
}

enum Currency {
  BRL
  USD
}

// ----------------------------------------------------
// USUÁRIOS E PROJETOS
// ----------------------------------------------------
model User {
  id              String      @id @default(uuid())
  email           String      @unique // E-mail principal (utilizado para login)
  secondaryEmail  String?     // E-mail pessoal / backup
  fullName        String?
  companyName     String?
  phone           String?
  document        String?     // CPF ou CNPJ
  address         String?     // Endereço completo
  avatarUrl       String?
  autentiqueDocId String?
  role            UserRole    @default(CLIENT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  projects        Project[]
  tickets         Ticket[]
  contracts       Contract[]
  invoices        Invoice[]
  auditLogs       AuditLog[]

  @@map("users")
}
model Project {
  id              String      @id @default(uuid())
  name            String      // Ex: "Clínica Camila Dias", "Instituto Kokopelli"
  slug            String      @unique
  domain          String?
  stagingUrl      String?
  description     String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  tickets         Ticket[]
  contracts       Contract[]

  @@map("projects")
}

// ----------------------------------------------------
// CHAMADOS, TICKETS E SLA
// ----------------------------------------------------
model Ticket {
  id              String          @id @default(uuid())
  ticketNumber    Int             @default(autoincrement())
  title           String
  description     String          @db.Text
  category        TicketCategory  @default(BASIC)
  status          TicketStatus    @default(OPEN)
  
  slaHours        Int             @default(24) // 24, 72 ou 168
  slaDueAt        DateTime
  resolvedAt      DateTime?
  slaPausedAt     DateTime?
  slaTotalPausedSeconds Int         @default(0)
  reopenReason    String?         @db.Text

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  attachments     TicketAttachment[]
  comments        TicketComment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("tickets")
}

model TicketAttachment {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  fileSize    Int?     // bytes
  mimeType    String?
  createdAt   DateTime @default(now())

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

model TicketComment {
  id          String   @id @default(uuid())
  message     String   @db.Text
  authorName  String
  isAdmin     Boolean  @default(false)
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

// ----------------------------------------------------
// MOTOR FINANCEIRO: CONTRATOS, PARCELAS & FATURAS
// ----------------------------------------------------
model Contract {
  id                  String            @id @default(uuid())
  contractNumber      String?
  title               String            // Ex: "Implantação Vitrine + Sustentação Development"
  contractType        ContractType      @default(HYBRID)
  status              ContractStatus    @default(ACTIVE)
  
  totalAmount         Decimal           @db.Decimal(12, 2)
  paidAmount          Decimal           @default(0.00) @db.Decimal(12, 2)
  
  startDate           DateTime          @default(now())
  endDate             DateTime?
  autentiqueDocId     String?           // ID do documento assinado no Autentique
  notes               String?           @db.Text

  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  installments        ContractInstallment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("contracts")
}

model ContractInstallment {
  id                String            @id @default(uuid())
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  scheduledDate     DateTime          // Data programada da parcela irregular
  status            InstallmentStatus @default(SCHEDULED)
  description       String?           // Ex: "Entrada Implantação", "Milestone 90 dias"

  contractId        String
  contract          Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)

  invoiceItemId     String?           @unique
  invoiceItem       InvoiceItem?      @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("contract_installments")
}

model Invoice {
  id                String         @id @default(uuid())
  invoiceNumber     String         @unique // order_nsu enviado para a InfinitePay
  dueDate           DateTime
  totalAmount       Decimal        @db.Decimal(12, 2)
  status            InvoiceStatus  @default(PENDING)
  paymentMethod     PaymentMethod?
  
  // Metadados InfinitePay
  gatewayPaymentId  String?        @unique // transaction_nsu ou slug retornado
  gatewayInvoiceUrl String?        // URL de checkout gerada pela InfinitePay
  receiptUrl        String?        // Link do comprovante retornado pelo webhook
  pixQrCode         String?        @db.Text
  pixCopyPaste      String?        @db.Text
  paidAt            DateTime?

  // Flags da Régua de Cobrança (Para evitar spam)
  reminder5DaysSent      Boolean        @default(false)
  dueDaySent             Boolean        @default(false)
  overdue1DaySent        Boolean        @default(false)
  critical2DaysSent      Boolean        @default(false)

  // Auditoria e rastreabilidade da régua automatizada
  reminderSentAt         DateTime?      // Disparo de 5 dias antes
  dueTodaySentAt         DateTime?      // Disparo do dia do vencimento
  overdueSentAt          DateTime?      // Disparo de 1 dia de atraso
  criticalOverdueSentAt  DateTime?      // Disparo de 3+ dias de atraso
  adminAlertSentAt       DateTime?      // Alerta interno enviado para contato@mindsite.com.br

  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  items             InvoiceItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id              String       @id @default(uuid())
  description     String       // Ex: "Sustentação Development - Mês 10/2026", "Parcela 2/4 Setup"
  amount          Decimal      @db.Decimal(12, 2)
  
  invoiceId       String
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  installment     ContractInstallment?

  createdAt       DateTime     @default(now())

  @@map("invoice_items")
}

// ----------------------------------------------------
// DESPESAS DA EMPRESA (FLUXO DO DONO / COTAÇÃO USD)
// ----------------------------------------------------
model CompanyExpense {
  id                  String            @id @default(uuid())
  name                String            // Ex: "Vercel Pro", "Supabase Pro", "Registro.br"
  category            ExpenseCategory   @default(INFRASTRUCTURE)
  frequency           ExpenseFrequency  @default(RECURRENT_MONTHLY)
  currency            Currency          @default(BRL)
  
  estimatedAmount     Decimal           @db.Decimal(12, 2)
  actualAmountPaid    Decimal?          @db.Decimal(12, 2)
  exchangeRateUsed    Decimal?          @db.Decimal(8, 4) // PTAX utilizada caso USD
  
  dueDate             DateTime
  paymentDate         DateTime?
  isPaid              Boolean           @default(false)
  receiptUrl          String?
  notes               String?           @db.Text

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("company_expenses")
}

// ----------------------------------------------------
// AUDITORIA LGPD & SEGURANÇA
// ----------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // LOGIN, PASSWORD_CHANGE, TICKET_OPEN, CONTRACT_SIGN, PROFILE_EDIT
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

